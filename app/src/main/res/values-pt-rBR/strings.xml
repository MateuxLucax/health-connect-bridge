    <string name="welcome_title">Boas-vindas</string>
    <string name="welcome_text">O app lê seus dados do Health Connect: frequência cardíaca, passos, sono, peso e mais. A cada 15 minutos, ele envia os dados para o seu servidor.</string>
    <string name="your_server">Seu servidor</string>
    <string name="prometheus_grafana">Prometheus e Grafana</string>
    <string name="welcome_server_text">O servidor (health-connect-prometheus-exporter) grava os dados no Prometheus. Você vê os gráficos no Grafana.</string>
    <string name="welcome_privacy_text">Os dados vão só para o servidor que você configurar. Nada vai para terceiros.</string>
