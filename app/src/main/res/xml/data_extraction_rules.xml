<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: keep the settings out of cloud backups and device-to-device transfers. They hold the
    server token, the Health Connect changes token and the last exported health values.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
