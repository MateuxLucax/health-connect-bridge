    <string name="welcome_title">Welcome</string>
    <string name="welcome_text">The app reads your Health Connect data: heart rate, steps, sleep, weight and more. It sends the data to your server every 15 minutes.</string>
    <string name="your_server">Your server</string>
    <string name="prometheus_grafana">Prometheus and Grafana</string>
    <string name="welcome_server_text">The server (health-connect-prometheus-exporter) stores the data in Prometheus. You view the charts in Grafana.</string>
    <string name="welcome_privacy_text">Data goes only to the server you set up. Nothing goes to third parties.</string>
    <string name="flow_watch">Watch</string>
    <string name="flow_phone">Phone</string>
    <string name="flow_server">Server</string>
    <string name="flow_grafana">Grafana</string>
    <string name="flow_description">Watch to phone to your server to Grafana</string>
    <string name="server_text">Enter the URL and token of your health-connect-prometheus-exporter. Home network example: http://192.168.0.10:8080</string>
    <string name="permissions_title">Permissions</string>
    <string name="permissions_text">The app only reads from Health Connect. It never writes. Allow the data you want to send. Also allow background and history access for automatic sync.</string>
    <string name="what_app_reads">What the app reads</string>
    <string name="battery_title">Battery</string>
    <string name="battery_text">On Galaxy (One UI) and other phones, battery optimization can stop background sync.</string>
    <string name="battery_text_2">Turn it off for this app so data reaches the server with the screen off. Each sync takes a few seconds, so battery use is low.</string>
    <string name="battery_skip_text">You can skip this and do it later in Settings.</string>
    <string name="history_text">Automatic sync sends the last 7 days and everything new. To send older data, import your history.</string>
    <string name="history_text_2">With the exporter’s default settings, Prometheus accepts data up to 30 days old. Older data is rejected.</string>
    <string name="history_text_3">You can also import later in Settings. Tap Done to start.</string>

