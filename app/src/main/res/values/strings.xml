    <string name="welcome_title">Welcome</string>
    <string name="welcome_text">This app reads your health data from Health Connect (heart rate, steps, sleep, weight and more) and sends it to your own server every 15 minutes.</string>
    <string name="your_server">Your server</string>
    <string name="prometheus_grafana">Prometheus and Grafana</string>
    <string name="welcome_server_text">The server (health-connect-prometheus-exporter) writes the data to Prometheus, and you follow everything in Grafana charts.</string>
    <string name="welcome_privacy_text">Your data goes only to the server you set up. Nothing is sent to third parties.</string>
    <string name="flow_watch">Watch</string>
    <string name="flow_phone">Phone</string>
    <string name="flow_server">Server</string>
    <string name="flow_grafana">Grafana</string>
    <string name="flow_description">Watch to phone to your server to Grafana</string>
    <string name="server_text">Enter the address of health-connect-prometheus-exporter and the token configured on it. On a home network, something like http://192.168.0.10:8080.</string>
    <string name="permissions_title">Permissions</string>
    <string name="permissions_text">The app only reads from Health Connect, it never writes. Grant access to the data you want to export, and also allow background and history access for automatic sync.</string>
    <string name="what_app_reads">What the app reads</string>
    <string name="battery_title">Battery</string>
    <string name="battery_text">On Galaxy (One UI) and other phones, battery optimization puts apps to sleep and can cancel the background sync.</string>
    <string name="battery_text_2">Turn off optimization for this app only, so the data reaches the server even with the screen off. The cost is small: each sync takes a few seconds.</string>
    <string name="battery_skip_text">If you prefer, skip this step and do it later in Settings.</string>
    <string name="history_text">Automatic sync sends the last 7 days and everything that arrives afterwards. To send older data, import the history: the app reads the last days from Health Connect again and sends them to the server.</string>
    <string name="history_text_2">Prometheus only accepts data within its out-of-order window, which is 30 days in the exporter’s default configuration. Older data is rejected.</string>
    <string name="history_text_3">You can also import later, in Settings. Tap Finish to start using the app.</string>

